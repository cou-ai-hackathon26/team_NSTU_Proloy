# Shoi Environment Configuration
APP_NAME="Shoi (সই) - Health Assistant"
DEBUG=True
SECRET_KEY=shoi-secret-key-change-in-production-random-uuid-64738291
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=90

# Database Configuration (PostgreSQL in production, SQLite default for zero-config dev)
# DATABASE_URL=postgresql://user:password@localhost:5432/shoi_db
DATABASE_URL=sqlite:///./shoi.db

# LLM Configuration (Options: ollama, openai_compatible, gemini, mock)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=30.0

# Optional Hosted Providers (Fallback or Alternative)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Voice, Audio & Speech Configuration
TTS_ENGINE=edge-tts
BANGLA_VOICE=bn-BD-NabanitaNeural
WHISPER_MODEL=base

# RAG Knowledge Settings
KB_CONFIDENCE_THRESHOLD=0.45
